generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL")
}

model Company {
  id                     String                  @id @default(cuid())
  name                   String
  logo                   String?
  email                  String?
  phone                  String?
  address                String?
  isActive               Boolean                 @default(true)
  /// SaaS onboarding: mobile_shop | repair_shop | trading
  businessType           String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  aiAlerts               AIAlert[]
  apiKeys                ApiKey[]
  barcodeSequences       BarcodeSequence?
  branches               Branch[]
  companySettings        CompanySettings?
  usage                  CompanyUsage?
  currencies             Currency[]
  currencyHistories      CurrencyHistory[]
  customers              Customer[]
  deviceHistories        DeviceHistory[]
  exchangeRateHistories  ExchangeRateHistory[]
  expenses               Expense[]
  fileUploads            FileUpload[]
  imeiHistories          IMEIHistory[]
  imeiRecords            IMEIRecord[]
  instituteAttendances   InstituteAttendance[]
  instituteBatches       InstituteBatch[]
  instituteCourses       InstituteCourse[]
  instituteEnrollments   InstituteEnrollment[]
  instituteFeeCharges    InstituteFeeCharge[]
  instituteStudents      InstituteStudent[]
  instituteExams         InstituteExam[]
  instituteExamResults   InstituteExamResult[]
  integrationLogs        IntegrationLog[]
  inventory              Inventory[]
  inventoryParts         InventoryPart[]
  investors              Investor[]
  investorTransactions   InvestorTransaction[]
  invoices               Invoice[]
  partCatalogSeries      PartCatalogSeries[]
  partCatalogSuggestions PartCatalogSuggestion[]
  payments               Payment[]
  pricingRules           PricingRule[]
  profitDistributions    ProfitDistribution[]
  profitReports          ProfitReport[]
  purchases              Purchase[]
  quotations             Quotation[]
  chatRooms              ChatRoom[]
  chatMessages           ChatMessage[]
  refurbishJobs          RefurbishJob[]
  repairs                Repair[]
  sales                  Sale[]
  salesOrders            SalesOrder[]
  setupProfile           SetupProfile?
  sourcingRequests       SourcingRequest[]
  stockAlerts            StockAlert[]
  stockMovements         StockMovement[]
  subscriptions          Subscription?
  suppliers              Supplier[]
  supplierFxRates        SupplierFxRate[]
  transfers              Transfer[]
  translations           Translation[]
  users                  User[]
  warranties             Warranty[]
  webhooks               Webhook[]
}

/// Post-signup onboarding wizard answers (per-tenant).
model SetupProfile {
  id                String   @id @default(cuid())
  companyId         String   @unique
  businessType      String
  /// Multi-select verticals chosen in setup wizard (e.g. ["Mobile Shop","Institute"]).
  /// Backward compatible: `businessType` remains the primary legacy value.
  businessTypes     Json?
  platform          String
  /// Array of ISO codes + optional sentinel 'OTHER'.
  sourcingCountries Json
  sourcingOther     String?
  requirements      String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model MasterCategory {
  id           String                      @id @default(cuid())
  name         String                      @unique
  nameZh       String?
  nameAr       String?
  nameUr       String?
  translations MasterCategoryTranslation[]
}

model MasterCategoryTranslation {
  id             String         @id @default(cuid())
  categoryId     String
  /// BCP-47 base language tag e.g. en | zh | ar | ur
  language       String
  translatedName String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  category       MasterCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, language])
  @@index([language])
}

model MasterSparePart {
  id   String @id @default(cuid())
  name String @unique
}

model MasterScreenQuality {
  id   String @id @default(cuid())
  name String @unique
}

model MasterToolBrand {
  id   String @id @default(cuid())
  name String @unique
}

model StorageSize {
  id     String @id @default(cuid())
  sizeGb Int    @unique
  label  String @unique
}

model DeviceColor {
  id   String @id @default(cuid())
  name String @unique
}

model DeviceQuality {
  id   String @id @default(cuid())
  name String @unique
}

model DeviceFault {
  id   String @id @default(cuid())
  name String @unique
}

model CompanySettings {
  id                    String    @id @default(cuid())
  companyId             String    @unique
  /// Company operating / reporting currency (does not change ledger USD pivot).
  baseCurrency          String    @default("USD")
  /// Legacy alias kept for backward compatibility with older clients.
  currency              String    @default("USD")
  timezone              String    @default("UTC")
  taxRate               Float     @default(0)
  invoicePrefix         String    @default("INV")
  logo                  String?
  /// Desk spread in basis points (1 bp = 0.01%). Buy/sell derived from mid; 0 = legacy single-rate display.
  spreadBps             Int       @default(0)
  /// Optional book equity in USD for capital reporting (company-owned capital).
  companyEquityUsd      Float?
  /// Inventory pricing method used for NEW sales only (historical sales are never recalculated).
  pricingMethod         String    @default("FIFO")
  /// Optional flag for "profit locked" milestone tracking (does not mutate historical sales).
  pricingLocked         Boolean   @default(false)
  pricingLockedAt       DateTime?
  /// When plan allows `removeBranding`, tenant may hide the footer credit (Enterprise).
  hidePoweredByBranding Boolean   @default(false)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  company               Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model SubscriptionPlan {
  id                    String         @id @default(cuid())
  name                  String         @unique
  /// Base recurring price (USD/month) before per-branch / per-module add-ons.
  priceMonthly          Float          @default(0)
  maxUsers              Int            @default(10)
  maxBranches           Int            @default(3)
  /// Feature toggles, e.g. { "multiCurrency": true, "aiInsights": false, "removeBranding": false }
  features              Json           @default("{}")
  active                Boolean        @default(true)
  /// flat | per_branch | per_module | unlimited
  pricingModel          String         @default("flat")
  /// Used when pricingModel = per_branch (USD per extra branch / month).
  pricePerBranchMonthly Float?
  /// Used when pricingModel = per_module: { "aiInsights": 29, "forexTrading": 19 }
  modulePrices          Json?
  /// When true, maxUsers / maxBranches caps are not enforced.
  limitsUnlimited       Boolean        @default(false)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  subscriptions         Subscription[]
}

/// One active billing row per company (maps to SaaS "CompanySubscription").
model Subscription {
  id                   String           @id @default(cuid())
  companyId            String           @unique
  planId               String
  startDate            DateTime
  endDate              DateTime
  status               String           @default("active")
  trialEndsAt          DateTime?
  /// Stripe Customer id (billing Phase 4.1 — no SDK wired yet).
  stripeCustomerId     String?
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  company              Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan                 SubscriptionPlan @relation(fields: [planId], references: [id])
}

/// Cached usage counters per tenant (recomputed from source tables).
model CompanyUsage {
  companyId         String   @id
  activeUsers       Int      @default(0)
  activeBranches    Int      @default(0)
  inventoryCount    Int      @default(0)
  salesCountMonthly Int      @default(0)
  updatedAt         DateTime @updatedAt
  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model Permission {
  id              String           @id @default(cuid())
  code            String           @unique
  name            String
  description     String?
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]
}

model RolePermission {
  id           String     @id @default(cuid())
  roleId       String
  permissionId String
  createdAt    DateTime   @default(now())
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model Role {
  id              String           @id @default(cuid())
  name            String           @unique
  description     String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  rolePermissions RolePermission[]
  users           User[]
}

model User {
  id                              String                  @id @default(cuid())
  email                           String
  password                        String
  name                            String
  phone                           String?
  roleId                          String
  /// Branch isolation role for operational access control (Phase 1).
  /// SUPER_ADMIN may have branchId = null; branch roles must have branchId.
  branchRole                      UserBranchRole          @default(BRANCH_USER)
  companyId                       String
  branchId                        String?
  /// UI / API locale: en | zh | ar | ur (BCP-47 base).
  language                        String                  @default("en")
  /// Preferred display / settlement currency (ISO 4217) for this user in the app shell.
  currency                        String                  @default("USD")
  isActive                        Boolean                 @default(true)
  /// Set when the user completes email verification (e.g. signup OTP).
  emailVerifiedAt                 DateTime?
  /// Set when phone ownership was verified (e.g. signup SMS/WhatsApp OTP).
  phoneVerifiedAt                 DateTime?
  /// When true, every login requires step-up OTP (channel below).
  twoFactorEnabled                Boolean                 @default(false)
  /// Preferred channel for login step-up codes: EMAIL | SMS | WHATSAPP.
  otpChannel                      String                  @default("EMAIL")
  createdAt                       DateTime                @default(now())
  updatedAt                       DateTime                @updatedAt
  activityLogs                    ActivityLog[]
  auditLogs                       AuditLog[]
  branchPermissions               BranchPermission[]
  createdInvoices                 Invoice[]               @relation("InvoiceCreatedBy")
  partCatalogSuggestionsReviewed  PartCatalogSuggestion[] @relation("PartCatalogSuggestionReviewedBy")
  partCatalogSuggestionsSubmitted PartCatalogSuggestion[] @relation("PartCatalogSuggestionSubmittedBy")
  passwordResets                  PasswordReset[]
  refurbishJobs                   RefurbishJob[]
  repairs                         Repair[]
  createdSalesOrders              SalesOrder[]            @relation("SalesOrderCreatedBy")
  transfers                       Transfer[]
  trustedDevices                  TrustedDevice[]
  chatMessages                    ChatMessage[]
  branch                          Branch?                 @relation(fields: [branchId], references: [id])
  company                         Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role                            Role                    @relation(fields: [roleId], references: [id])

  @@unique([companyId, email])
  @@index([companyId])
}

/// Browser-stable device id (client UUID) + last-seen network context for new-device login checks.
model TrustedDevice {
  id           String   @id @default(cuid())
  userId       String
  deviceId     String
  userAgent    String?
  lastIp       String?
  lastLocation String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, deviceId])
  @@index([userId])
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([expiresAt])
}

model Branch {
  id                 String              @id @default(cuid())
  companyId          String
  name               String
  code               String?
  adminName          String?
  /// Operating currency for this branch (ISO 4217). Auth/session exposes this as `branchDefaultCurrency`.
  currency           String?             @default("USD")
  /// Institute tuition / fee postings default to this ISO code when set; otherwise `currency` (operating).
  instituteFeeCurrency       String?
  /// Receipts & payment rows default to this when set; otherwise fee currency → operating.
  instituteReceiptCurrency   String?
  /// Branch-scoped financial reports for institute (and related AR); otherwise operating `currency`.
  instituteReportingCurrency String?
  /// Enterprise: branch-level operating margin/overhead percent (0–100). Used in profit analytics.
  marginPercent      Float               @default(0)
  /// Default UI language for users assigned to this branch when they have no explicit `User.language`.
  defaultLanguage    String              @default("en")
  country            String?
  province           String?
  city               String?
  address            String?
  phone              String?
  logo               String?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  aiAlerts           AIAlert[]
  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts           BranchContact[]
  branchPermissions  BranchPermission[]
  expenses           Expense[]
  instituteStudents  InstituteStudent[]
  inventory          Inventory[]
  inventoryLocations InventoryLocation[]
  inventoryParts     InventoryPart[]
  invoices           Invoice[]
  payments           Payment[]
  purchases          Purchase[]
  refurbishJobs      RefurbishJob[]
  repairs            Repair[]
  sales              Sale[]
  salesOrders        SalesOrder[]
  stockMovements     StockMovement[]
  transfersFrom      Transfer[]          @relation("TransferFrom")
  transfersTo        Transfer[]          @relation("TransferTo")
  users              User[]
  chatRoomsAsBranch  ChatRoom[]          @relation("ChatRoomBranch")
  chatRoomsAsA       ChatRoom[]          @relation("ChatRoomBranchA")
  chatRoomsAsB       ChatRoom[]          @relation("ChatRoomBranchB")
  chatMessages       ChatMessage[]
  instituteExams     InstituteExam[]

  @@index([companyId])
}

model BranchContact {
  id          String   @id @default(cuid())
  branchId    String
  contactType String
  value       String
  createdAt   DateTime @default(now())
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

model Supplier {
  id               String            @id @default(cuid())
  companyId        String
  /// Default settlement / quote currency for this supplier (ISO 4217).
  currency         String            @default("USD")
  name             String
  companyName      String?
  email            String?
  website          String?
  country          String
  province         String?
  city             String?
  address          String?
  openingBalance   Float             @default(0)
  balanceType      String            @default("debit")
  paymentMethod    String?
  moneyStatus      String?
  availableBalance Float             @default(0)
  blockedBalance   Float             @default(0)
  contact          String?
  phone            String?
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  priceHistory     PriceHistory[]
  purchases        Purchase[]
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts         SupplierContact[]
  fxRates          SupplierFxRate[]
  supplierRatings  SupplierRating[]

  @@index([companyId])
}

model SupplierContact {
  id          String   @id @default(cuid())
  supplierId  String
  contactType String
  value       String
  qrCodeUrl   String?
  createdAt   DateTime @default(now())
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  @@index([supplierId])
}

model Customer {
  id             String            @id @default(cuid())
  companyId      String
  name           String
  companyName    String?
  email          String?
  website        String?
  country        String?
  province       String?
  city           String?
  address        String?
  openingBalance Float             @default(0)
  balanceType    String            @default("debit")
  paymentMethod  String?
  moneyStatus    String?
  phone          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  company        Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts       CustomerContact[]
  invoices       Invoice[]
  payments       Payment[]
  purchases      Purchase[]
  repairs        Repair[]
  sales          Sale[]
  salesOrders    SalesOrder[]

  @@index([companyId])
}

model CustomerContact {
  id          String   @id @default(cuid())
  customerId  String
  contactType String
  value       String
  qrCodeUrl   String?
  createdAt   DateTime @default(now())
  customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model PhoneBrand {
  id           String                  @id @default(cuid())
  name         String                  @unique
  createdAt    DateTime                @default(now())
  translations PhoneBrandTranslation[]
  phoneModels  PhoneModel[]
}

model PhoneBrandTranslation {
  id             String     @id @default(cuid())
  brandId        String
  /// BCP-47 base language tag e.g. en | zh | ar | ur
  language       String
  translatedName String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  brand          PhoneBrand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@unique([brandId, language])
  @@index([language])
}

model PhoneModel {
  id                String                  @id @default(cuid())
  brandId           String
  name              String
  releaseYear       Int?
  createdAt         DateTime                @default(now())
  partCatalogSeries PartCatalogSeries[]
  brand             PhoneBrand              @relation(fields: [brandId], references: [id], onDelete: Cascade)
  translations      PhoneModelTranslation[]
  variants          PhoneVariant[]

  @@unique([brandId, name])
  @@index([brandId])
}

model PhoneModelTranslation {
  id             String     @id @default(cuid())
  modelId        String
  /// BCP-47 base language tag e.g. en | zh | ar | ur
  language       String
  translatedName String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  model          PhoneModel @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, language])
  @@index([language])
}

model PhoneVariant {
  id                         String                         @id @default(cuid())
  modelId                    String
  storage                    String
  color                      String
  createdAt                  DateTime                       @default(now())
  deviceSpecs                DeviceSpecification[]
  inventory                  Inventory[]
  partCatalogCompatibilities PartCatalogItemCompatibility[]
  model                      PhoneModel                     @relation(fields: [modelId], references: [id], onDelete: Cascade)

  @@unique([modelId, storage, color])
  @@index([modelId])
}

model DeviceGrade {
  id            String         @id @default(cuid())
  code          String         @unique
  name          String
  description   String?
  inventory     Inventory[]
  refurbishJobs RefurbishJob[]
}

model Inventory {
  id                     String           @id @default(cuid())
  companyId              String
  imei                   String           @unique
  barcode                String?          @unique
  /// phone | part | accessory
  productType            String           @default("phone")
  brand                  String
  model                  String
  storage                String
  color                  String
  condition              String
  purchasePrice          Float
  /// True when cost basis is not fully auditable (e.g. pre-migration stock). Reports must show the legacy-cost warning label.
  /// Optional one-time SQL after deploy: UPDATE "Inventory" SET "isLegacyCost" = true WHERE "costUsd" IS NULL;
  isLegacyCost           Boolean          @default(false)
  /// Optional: unit cost in `originalCurrency` before FX to USD (audit trail: original → converted → costUsd).
  originalCost           Float?
  originalCurrency       String?
  /// Ledger cost in USD at acquisition (authoritative for COGS / FIFO-LIFO). Null = legacy row (use purchasePrice as USD heuristic in reads).
  costUsd                Float?
  /// ISO currency of `purchasePrice` at acquisition (when set with costUsd).
  purchaseCurrency       String?
  /// Units of `purchaseCurrency` per 1 USD at acquisition (same convention as Sale.exchangeRateAtTransaction).
  exchangeRateAtPurchase Float?
  cargoCost              Float            @default(0)
  sellingPrice           Float
  branchId               String
  /// available | sold | repair | damaged | transferred
  status                 String           @default("available")
  notes                  String?
  phoneVariantId         String?
  deviceGradeId          String?
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  deviceHistory          DeviceHistory[]
  imeiRecords            IMEIRecord[]
  branch                 Branch           @relation(fields: [branchId], references: [id])
  company                Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deviceGrade            DeviceGrade?     @relation(fields: [deviceGradeId], references: [id])
  phoneVariant           PhoneVariant?    @relation(fields: [phoneVariantId], references: [id])
  invoiceItems           InvoiceItem[]
  quotationItems         QuotationItem[]
  saleItems              SaleItem[]
  salesOrderItems        SalesOrderItem[]
  stockMovements         StockMovement[]
  transferItems          TransferItem[]

  @@index([imei])
  @@index([barcode])
  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
}

model BarcodeSequence {
  id         String   @id @default(cuid())
  companyId  String   @unique
  lastNumber Int      @default(0)
  updatedAt  DateTime @updatedAt
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model IMEIRecord {
  id          String     @id @default(cuid())
  companyId   String
  imei        String
  inventoryId String?
  action      String
  notes       String?
  createdAt   DateTime   @default(now())
  company     Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventory   Inventory? @relation(fields: [inventoryId], references: [id])

  @@index([imei])
  @@index([companyId])
}

model StockMovement {
  id           String    @id @default(cuid())
  companyId    String
  inventoryId  String
  movementType String
  branchId     String
  userId       String?
  referenceId  String?
  quantity     Int       @default(1)
  createdAt    DateTime  @default(now())
  branch       Branch    @relation(fields: [branchId], references: [id])
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventory    Inventory @relation(fields: [inventoryId], references: [id])

  @@index([inventoryId])
  @@index([companyId])
  @@index([branchId])
  @@index([createdAt])
}

model Transfer {
  id                    String         @id @default(cuid())
  companyId             String
  fromBranchId          String
  toBranchId            String
  createdById           String
  status                String         @default("pending")
  approvedById          String?
  approvedAt            DateTime?
  transferMarginPercent Float          @default(0)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  company               Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy             User           @relation(fields: [createdById], references: [id])
  fromBranch            Branch         @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch              Branch         @relation("TransferTo", fields: [toBranchId], references: [id])
  transferItems         TransferItem[]

  @@index([companyId])
}

model TransferItem {
  id          String    @id @default(cuid())
  transferId  String
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id])
  transfer    Transfer  @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@index([inventoryId])
}

/// TODO(phase-decimal): migrate monetary `Float` fields (e.g. totalAmount, cargoCost, totalAmountUsd, cargoCostUsd) to Prisma `Decimal`; keep arithmetic in `src/utils/money.ts`.
model Purchase {
  id                        String           @id @default(cuid())
  companyId                 String
  supplierId                String?
  customerId                String?
  branchId                  String
  totalAmount               Float
  cargoCost                 Float            @default(0)
  taxAmount                 Float            @default(0)
  otherCosts                Float            @default(0)
  currency                  String           @default("USD")
  /// Trading-grade audit aliases (safe additions). Same meaning as `currency` / `exchangeRateAtTransaction`.
  purchaseCurrency          String?
  /// Normalized totals in USD (ledger); optional for legacy rows — COALESCE with raw amounts when currency was USD
  totalAmountUsd            Float?
  cargoCostUsd              Float?
  /// Units of `currency` per 1 USD at posting time; 1 for USD
  exchangeRateAtTransaction Float?
  /// Alias of `exchangeRateAtTransaction` for purchases (auditable intent).
  exchangeRateAtPurchase    Float?
  status                    String           @default("pending")
  notes                     String?
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  inventoryBatches          InventoryBatch[]
  branch                    Branch           @relation(fields: [branchId], references: [id])
  company                   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer                  Customer?        @relation(fields: [customerId], references: [id])
  supplier                  Supplier?        @relation(fields: [supplierId], references: [id])
  purchaseItems             PurchaseItem[]

  @@index([companyId])
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  imei        String
  /// phone | part | accessory
  productType String   @default("phone")
  brand       String
  model       String
  storage     String
  color       String
  condition   String
  price       Float
  quantity    Int      @default(1)
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
}

/// TODO(phase-decimal): migrate monetary `Float` fields (e.g. totalAmount, profit, totalAmountUsd, profitUsd) to Prisma `Decimal`; keep arithmetic in `src/utils/money.ts`.
/// DEPRECATED — use Invoice as the operational billing source of truth.
/// Kept temporarily for legacy compatibility and historical migration bridges.
model Sale {
  id                        String     @id @default(cuid())
  companyId                 String
  branchId                  String
  customerId                String?
  totalAmount               Float
  profit                    Float      @default(0)
  /// ISO currency of totalAmount / profit (defaults USD for legacy)
  currency                  String     @default("USD")
  /// Ledger-normalized amounts in USD; optional on legacy rows
  totalAmountUsd            Float?
  profitUsd                 Float?
  /// Units of `currency` per 1 USD at posting time; 1 for USD
  exchangeRateAtTransaction Float?
  /// Pricing method snapshot used when this sale was created (audit safety).
