  amountUsd                 Float?
  /// Units of `currency` per 1 USD at posting time; 1 for USD
  exchangeRateAtTransaction Float?
  description               String?
  referenceType             String?
  referenceId               String?
  expenseDate               DateTime @default(now())
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
  branch                    Branch?  @relation(fields: [branchId], references: [id], onDelete: Restrict)
  company                   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([expenseDate])
  @@index([branchId])
}

/// External capital providers (equity investors vs debt lenders).
/// TODO(phase-decimal): migrate monetary `Float` fields (capitalAmount, related transactions) to Prisma `Decimal`; keep arithmetic in `src/utils/money.ts`.
model Investor {
  id                  String                @id @default(cuid())
  companyId           String
  name                String
  /// investor = profit-sharing eligible; lender = principal / interest only (no sharePercentage)
  type                String                @default("investor")
  /// Declared / book principal in `currency` (complement cash flows in InvestorTransaction)
  capitalAmount       Float                 @default(0)
  currency            String                @default("USD")
  /// 0–100 when type is investor; null for lenders
  sharePercentage     Float?
  startDate           DateTime              @default(now())
  active              Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  company             Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  transactions        InvestorTransaction[]
  profitDistributions ProfitDistribution[]

  @@index([companyId])
  @@index([companyId, type])
  @@index([companyId, active])
}

model InvestorTransaction {
  id                        String   @id @default(cuid())
  companyId                 String
  investorId                String
  type                      String
  amount                    Float
  currency                  String   @default("USD")
  amountUsd                 Float?
  exchangeRateAtTransaction Float?
  date                      DateTime @default(now())
  createdAt                 DateTime @default(now())
  company                   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  investor                  Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([investorId])
  @@index([date])
}

/// Paid profit share allocations per investor (auditable history).
model ProfitDistribution {
  id         String   @id @default(cuid())
  companyId  String
  investorId String
  /// Amount paid/allocated in USD (ledger currency for distributions)
  amountUsd  Float
  /// Period label for reporting/audit, e.g. "2026-03" or "2026-Q1"
  period     String
  /// Date the distribution was paid/recorded
  date       DateTime @default(now())
  createdAt  DateTime @default(now())
  company    Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  investor   Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([investorId])
  @@index([period])
  @@index([date])
}

model Payment {
  id                        String              @id @default(cuid())
  companyId                 String
  branchId                  String?
  customerId                String?
  saleId                    String?
  purchaseId                String?
  invoiceId                 String?
  /// Optional link to an institute fee charge this payment was allocated to.
  /// Set by the institute payment service which also updates the fee charge's
  /// `paidAmount` / `balance` / `status` in the same transaction.
  instituteFeeChargeId      String?
  amount                    Float
  currency                  String              @default("USD")
  amountUsd                 Float?
  /// Units of `currency` per 1 USD at posting time; 1 for USD
  exchangeRateAtTransaction Float?
  method                    String              @default("cash")
  reference                 String?
  status                    String              @default("completed")
  paidAt                    DateTime            @default(now())
  createdAt                 DateTime            @default(now())
  branch                    Branch?             @relation(fields: [branchId], references: [id])
  company                   Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer                  Customer?           @relation(fields: [customerId], references: [id])
  invoice                   Invoice?            @relation(fields: [invoiceId], references: [id])
  instituteFeeCharge        InstituteFeeCharge? @relation(fields: [instituteFeeChargeId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([saleId])
  @@index([purchaseId])
  @@index([invoiceId])
  @@index([instituteFeeChargeId])
  @@index([branchId])
  @@index([paidAt])
}

model ProfitReport {
  id           String   @id @default(cuid())
  companyId    String
  branchId     String?
  periodType   String
  periodStart  DateTime
  periodEnd    DateTime
  totalRevenue Float    @default(0)
  totalCost    Float    @default(0)
  repairCost   Float    @default(0)
  partsCost    Float    @default(0)
  profit       Float    @default(0)
  deviceCount  Int      @default(0)
  createdAt    DateTime @default(now())
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, branchId, periodType, periodStart])
  @@index([companyId])
  @@index([periodStart])
}

model InstituteStudent {
  id          String                @id @default(cuid())
  companyId   String
  branchId    String?
  studentCode String?
  fullName    String
  email       String?
  phone       String?
  /// Personal / CRM profile (nullable — legacy rows remain valid).
  gender            String?
  dateOfBirth       DateTime?
  profilePhotoUrl   String?
  nationalId        String?
  bloodGroup        String?
  whatsApp          String?
  addressLine       String?
  city              String?
  country           String?
  fatherName        String?
  motherName        String?
  guardianName      String?
  emergencyContact  String?
  guardianPhone     String?
  previousSchool    String?
  qualification           String?
  notes                   String?
  /// NIC/passport or guardian-held ID: type discriminator + number (legacy `nationalId` still supported).
  identityDocumentType    String?
  identityDocumentNumber  String?
  status      String                @default("active")
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  enrollments InstituteEnrollment[]
  feeCharges  InstituteFeeCharge[]
  branch      Branch?               @relation(fields: [branchId], references: [id])
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, studentCode])
  @@index([companyId])
}

model InstituteCourse {
  id          String           @id @default(cuid())
  companyId   String
  title       String
  code        String?
  description String?
  active      Boolean          @default(true)
  /// Default tuition charged when a student is enrolled into any batch of this
  /// course. Optional — leave null and rely on `InstituteBatch.feeOverride`,
  /// or pass an explicit `fees` array to `enrollStudent()`. Stored as
  /// Decimal(18,4) for precise money math.
  defaultFee  Decimal?         @db.Decimal(18, 4)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  batches     InstituteBatch[]
  company     Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, code])
  @@index([companyId])
}

model InstituteBatch {
  id          String                @id @default(cuid())
  companyId   String
  courseId    String
  name        String
  startsOn    DateTime?
  endsOn      DateTime?
  /// Optional per-batch tuition; takes precedence over
  /// `InstituteCourse.defaultFee` during auto fee generation.
  feeOverride Decimal?              @db.Decimal(18, 4)
  /// morning | evening | weekend — drives timetable UX.
  timingSlot  String?
  timingLabel String?
  teacherName String?
  capacity    Int?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  attendances InstituteAttendance[]
  exams       InstituteExam[]
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  course      InstituteCourse       @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrollments InstituteEnrollment[]

  @@index([companyId])
  @@index([courseId])
}

model InstituteEnrollment {
  id          String                @id @default(cuid())
  /// Tenant scope. Required for multi-tenant safety; was previously inferred
  /// only via joins on `student.companyId` / `batch.companyId`.
  companyId   String
  studentId   String
  batchId     String
  status      String                @default("active")
  enrolledAt  DateTime              @default(now())
  admissionDate         DateTime?
  expectedCompletionDate DateTime?
  attendances InstituteAttendance[]
  examResults InstituteExamResult[]
  feeCharges  InstituteFeeCharge[]
  batch       InstituteBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  company     Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  student     InstituteStudent      @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([companyId, studentId, batchId])
  @@index([companyId, batchId])
  @@index([batchId])
}

model InstituteFeeCharge {
  id           String               @id @default(cuid())
  companyId    String
  studentId    String
  /// Optional link to the enrollment that triggered this charge. Auto-populated
  /// by `enrollStudent()`; manually-issued charges (penalties, ad-hoc fees)
  /// can leave it null.
  enrollmentId String?
  label        String?
  /// Decimal(18,4) — institute money is stored exactly. Status transitions
  /// (`pending` → `partial` → `paid`) are driven by `paidAmount` vs `amount`.
  amount       Decimal              @db.Decimal(18, 4)
  /// Sum of all allocated payments. Updated transactionally by the institute
  /// payment service; never edit by hand.
  paidAmount   Decimal              @default(0) @db.Decimal(18, 4)
  /// Outstanding balance = amount − paidAmount. Stored (not computed) so that
  /// reports can index/filter on it without a derived view.
  balance      Decimal              @db.Decimal(18, 4)
  currency     String               @default("USD")
  dueDate      DateTime?
  status       String               @default("pending")
  paidAt       DateTime?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  company      Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enrollment   InstituteEnrollment? @relation(fields: [enrollmentId], references: [id], onDelete: SetNull)
  student      InstituteStudent     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments     Payment[]

  @@index([companyId])
  @@index([studentId])
  @@index([enrollmentId])
  @@index([companyId, status])
  @@index([companyId, dueDate])
}

model InstituteAttendance {
  id           String              @id @default(cuid())
  companyId    String
  batchId      String
  enrollmentId String
  date         DateTime
  present      Boolean             @default(true)
  notes        String?
  createdAt    DateTime            @default(now())
  batch        InstituteBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  enrollment   InstituteEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, date])
  @@index([companyId])
  @@index([batchId])
}

/// An exam / assessment within a batch (quiz, midterm, final, etc.).
model InstituteExam {
  id            String                @id @default(cuid())
  companyId     String
  branchId      String?
  batchId       String
  title         String
  /// quiz | assignment | practical | viva | midterm | final
  type          String                @default("quiz")
  totalMarks    Int
  passingMarks  Int
  examDate      DateTime?
  /// Weight for weighted-average GPA / aggregate calculations (0–100).
  weightPercent Int?
  remarks       String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  results       InstituteExamResult[]
  batch         InstituteBatch        @relation(fields: [batchId], references: [id], onDelete: Cascade)
  branch        Branch?               @relation(fields: [branchId], references: [id])
  company       Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([batchId])
  @@index([companyId, batchId])
}

/// A single student's marks in a specific exam.
model InstituteExamResult {
  id            String              @id @default(cuid())
  companyId     String
  examId        String
  enrollmentId  String
  obtainedMarks Int
  /// Server-calculated: (obtainedMarks / exam.totalMarks) * 100
  percentage    Decimal             @db.Decimal(5, 2)
  /// Configurable grade string (A+, A, B, etc.) — set by grading helper.
  grade         String?
  /// Optional GPA point value (e.g. 4.0 scale).
  gpa           Decimal?            @db.Decimal(3, 2)
  /// pass | fail | absent | withheld
  status        String              @default("pass")
  remarks       String?
  createdAt     DateTime            @default(now())
  exam          InstituteExam       @relation(fields: [examId], references: [id], onDelete: Cascade)
  enrollment    InstituteEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  company       Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([examId, enrollmentId])
  @@index([companyId])
  @@index([examId])
  @@index([enrollmentId])
  @@index([companyId, enrollmentId])
}

/// Device root of the catalog hierarchy (Device → Category → Subcategory → Part).
model PartCatalogSeries {
  id           String                @id @default(cuid())
  companyId    String
  name         String
  slug         String?
  sortOrder    Int                   @default(0)
  /// Optional link to global phone DB model for canonical device identity.
  phoneModelId String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  categories   PartCatalogCategory[]
  company      Company               @relation(fields: [companyId], references: [id], onDelete: Cascade)
  phoneModel   PhoneModel?           @relation(fields: [phoneModelId], references: [id])

  @@unique([companyId, name])
  @@index([companyId])
  @@index([phoneModelId])
}

model PartCatalogCategory {
  id          String                   @id @default(cuid())
  seriesId    String
  parentId    String?
  name        String
  sortOrder   Int                      @default(0)
  /// Set only on root categories (parentId null): Major parts | Camera | Small parts buckets.
  band        PartCatalogCategoryBand?
  /// Only leaf subcategories (parent set, no children) should allow parts — enforced in services.
  allowsParts Boolean                  @default(false)
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt
  parent      PartCatalogCategory?     @relation("PartCatalogCategoryHierarchy", fields: [parentId], references: [id])
  children    PartCatalogCategory[]    @relation("PartCatalogCategoryHierarchy")
  series      PartCatalogSeries        @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  parts       PartCatalogItem[]

  @@unique([seriesId, parentId, name])
  @@index([seriesId])
}

model PartCatalogItem {
  id              String                         @id @default(cuid())
  categoryId      String
  sku             String
  qualityGrade    PartCatalogQualityGrade        @default(OEM)
  name            String
  description     String?
  oemPartNumber   String?
  metadata        Json?
  isActive        Boolean                        @default(true)
  createdAt       DateTime                       @default(now())
  updatedAt       DateTime                       @updatedAt
  category        PartCatalogCategory            @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  compatibilities PartCatalogItemCompatibility[]

  @@unique([categoryId, sku, qualityGrade])
  @@index([categoryId])
}

/// Compatibility is stored at phone variant granularity (model-wide rules explode to variants on apply).
model PartCatalogItemCompatibility {
  id             String          @id @default(cuid())
  partItemId     String
  phoneVariantId String
  createdAt      DateTime        @default(now())
  partItem       PartCatalogItem @relation(fields: [partItemId], references: [id], onDelete: Cascade)
  phoneVariant   PhoneVariant    @relation(fields: [phoneVariantId], references: [id], onDelete: Cascade)

  @@unique([partItemId, phoneVariantId])
  @@index([phoneVariantId])
}

/// AI / imports / users propose catalog rows; approved mutations run only through apply — never direct AI inserts.
model PartCatalogSuggestion {
  id                String                      @id @default(cuid())
  companyId         String
  source            PartCatalogSuggestionSource
  status            PartCatalogSuggestionStatus @default(PENDING)
  payload           Json
  submittedByUserId String?
  reviewerUserId    String?
  reviewNotes       String?
  reviewedAt        DateTime?
  appliedAt         DateTime?
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt
  company           Company                     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  reviewer          User?                       @relation("PartCatalogSuggestionReviewedBy", fields: [reviewerUserId], references: [id])
  submitter         User?                       @relation("PartCatalogSuggestionSubmittedBy", fields: [submittedByUserId], references: [id])

  @@index([companyId, status])
}

model SourcingRequest {
  id              String   @id @default(cuid())
  companyId       String
  branchId        String?
  createdByUserId String?
  /// Structured line items / filters (JSON) — validated at application layer.
  structured      Json     @default("{}")
  customNotes     String?
  status          String   @default("open")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([status])
}

/// Auto Quotation — pricing band (per company).
/// A rule matches when `minPrice <= costPrice <= maxPrice`.
/// Selling price = costPrice + (costPrice * profitPercent / 100).
model PricingRule {
  id            String   @id @default(cuid())
  companyId     String
  name          String
  /// Inclusive lower bound for cost price (transaction currency, USD heuristic).
  minPrice      Float
  /// Inclusive upper bound for cost price.
  maxPrice      Float
  /// Margin to add on top of cost (percent, 0–1000).
  profitPercent Float
  /// Soft-disable a rule without deleting it.
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([companyId, active])
  @@index([companyId, minPrice, maxPrice])
}

/// Auto Quotation — header.
/// `totalAmount` is the sum of `QuotationItem.sellingPrice * quantity` at generate time.
model Quotation {
  id            String          @id @default(cuid())
  companyId     String
  /// Optional snapshot of the customer's display name (no FK so quotes survive customer deletes).
  customerName  String?
  /// Optional WhatsApp/phone destination, stored for share receipts.
  customerPhone String?
  notes         String?
  totalAmount   Float           @default(0)
  createdById   String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  company       Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items         QuotationItem[]

  @@index([companyId])
  @@index([createdAt])
}

/// Auto Quotation — line.
/// Either `inventoryId` (existing stock row) or free-text `description`+`costPrice`.
model QuotationItem {
  id            String     @id @default(cuid())
  quotationId   String
  /// Optional link to the underlying Inventory row (for in-stock items).
  inventoryId   String?
  /// Free-text fallback when not linked to inventory (e.g. ad-hoc quote line).
  description   String?
  quantity      Int        @default(1)
  costPrice     Float      @default(0)
  sellingPrice  Float      @default(0)
  profitPercent Float      @default(0)
  /// PricingRule used to compute sellingPrice (null when no rule matched and fallback was used).
  pricingRuleId String?
  createdAt     DateTime   @default(now())
  inventory     Inventory? @relation(fields: [inventoryId], references: [id])
  quotation     Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([inventoryId])
}

/// Internal Branch Chat — channel between users.
///
/// Three room kinds:
///  - `BRANCH`     : everyone in a single branch (uses `branchId`).
///  - `BRANCH_PAIR`: a 1:1 channel between two branches (`branchAId`, `branchBId`,
///                   stored sorted so lookups are deterministic).
///  - `COMPANY`    : company-wide channel (no branch refs).
///
/// Tenant isolation: every room belongs to exactly one company; cross-company
/// chat is impossible by construction.
model ChatRoom {
  id        String        @id @default(cuid())
  companyId String
  /// One of: `BRANCH` | `BRANCH_PAIR` | `COMPANY`. (String for forward-compat.)
  kind      String
  /// Display name, cached for UI; recomputed on branch rename via service.
  name      String
  /// Set when `kind = BRANCH`. NULL for `BRANCH_PAIR` and `COMPANY`.
  branchId  String?
  /// `BRANCH_PAIR` only — the lower-id branch of the pair (sorted asc).
  branchAId String?
  /// `BRANCH_PAIR` only — the higher-id branch of the pair (sorted asc).
  branchBId String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  company   Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  branch    Branch?       @relation("ChatRoomBranch", fields: [branchId], references: [id])
  branchA   Branch?       @relation("ChatRoomBranchA", fields: [branchAId], references: [id])
  branchB   Branch?       @relation("ChatRoomBranchB", fields: [branchBId], references: [id])
  messages  ChatMessage[]

  @@unique([companyId, kind, branchId, branchAId, branchBId], name: "chatroom_company_kind_unique")
  @@index([companyId])
  @@index([companyId, kind])
  @@index([branchId])
}

/// Internal Branch Chat — a single message inside a `ChatRoom`.
///
/// `companyId` is denormalised so cheap tenant-scoped queries (and indices)
/// don't require a join through `ChatRoom`.
model ChatMessage {
  id             String   @id @default(cuid())
  companyId      String
  chatRoomId     String
  /// Sender (User). Kept nullable so deleted users don't blow up history.
  senderId       String?
  /// Sender branch at write time — denormalised so the UI can label messages
  /// by branch even after a user is reassigned.
  senderBranchId String?
  /// Plain-text message body. UI is responsible for sanitising / truncating.
  body           String
  createdAt      DateTime @default(now())
  company        Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  chatRoom       ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)
  sender         User?    @relation(fields: [senderId], references: [id])
  senderBranch   Branch?  @relation(fields: [senderBranchId], references: [id])

  @@index([chatRoomId, createdAt])
  @@index([companyId, createdAt])
}

enum UserBranchRole {
  SUPER_ADMIN
  BRANCH_ADMIN
  BRANCH_USER
}

enum PartCatalogQualityGrade {
  ORIGINAL
  OEM
  COPY
}

/// Root taxonomy bucket under a device (major assemblies vs camera stack vs consumables).
enum PartCatalogCategoryBand {
  MAJOR_PARTS
  CAMERA
  SMALL_PARTS
}

enum PartCatalogSuggestionSource {
  AI
  IMPORT
  USER
}

enum PartCatalogSuggestionStatus {
  PENDING
  REJECTED
  APPLIED
}
