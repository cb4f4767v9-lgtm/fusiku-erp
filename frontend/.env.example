# API base URL (see vite config; typically ends with /api/v1)
VITE_API_URL=http://localhost:3001/api/v1

# Default tenant when the app cannot infer company from session (development / first install)
VITE_DEFAULT_COMPANY_ID=

# After a successful online session, offline use is allowed until this many days pass without refreshing online (1–365). Default in code: 7.
VITE_OFFLINE_LICENSE_DAYS=7
